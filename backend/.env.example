# ============================
# PILAH PILIH - ENV CONFIG
# ============================

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (ganti dengan string acak panjang!)
JWT_SECRET=pilahpilih_super_secret_key_2025_change_this_in_production
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./database/pilahpilih.db

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
FRONTEND_URL=http://localhost:3000
